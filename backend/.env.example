# Copia este archivo a `.env` y ajusta los valores. NUNCA commitees `.env`.

# App
PORT=3000
NODE_ENV=development

# Base de datos
DATABASE_URL="postgresql://tocosas:tocosas@localhost:5432/tocosas?schema=public"

# Redis (cache + colas BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="cambia-esto"
JWT_REFRESH_SECRET="cambia-esto-tambien"
JWT_ACCESS_TTL="3600"

# WhatsApp (Meta Cloud API) — ver docs/04-integracion-whatsapp.md
WHATSAPP_PROVIDER="meta"            # meta | twilio
WHATSAPP_VERIFY_TOKEN="cambia-esto"
WHATSAPP_APP_SECRET=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Salud Financiera (FIN-004) — gate técnico de producción (DEC-0004 §10.3):
# el Score NO se expone en producción hasta validación legal formal.
HEALTH_SCORE_PRODUCTION_ENABLED="false"

# Monetización Millo+ (FIN-009)
# Precio PLACEHOLDER (DEC-0009 §10.5): sin cobros reales hasta fijarlo con la
# telemetría de costo variable (GET /billing/admin/cost-report).
MILLOPLUS_PRICE_COP="0"
REVENUECAT_WEBHOOK_SECRET=""

# Telegram (Bot API) — crea el bot con @BotFather
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="MilloBot"
TELEGRAM_WEBHOOK_SECRET=""

# IA de Millo (Copiloto, bot y documentos) — Google Gemini
# Clave de un proyecto con facturación (plan de pago: Google no entrena con los datos).
# Vacía → el Copiloto responde con plantillas.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Opcional: otro modelo solo para leer extractos/facturas (por defecto, el mismo).
GEMINI_EXTRACT_MODEL=""
COPILOT_PRODUCTION_ENABLED="false"

# Firebase (FCM push)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
