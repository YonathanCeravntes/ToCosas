{
  "expo": {
    "name": "Millo",
    "slug": "millo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "millo",
    "owner": "millo_app",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/523d23dc-5053-49c8-85b0-d94ebf1e708d",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B6E4F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.tocosas.app"
    },
    "android": {
      "package": "co.tocosas.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B6E4F"
      }
    },
    "extra": {
      "apiUrl": "http://localhost:3000/v1",
      "eas": {
        "projectId": "523d23dc-5053-49c8-85b0-d94ebf1e708d"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ]
  }
}
